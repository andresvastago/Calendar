<!DOCTYPE html>
<html lang="es" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Everything You Neglect, You Lose</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Merriweather', 'serif'],
                    },
                    colors: {
                        orbit1: '#818cf8', orbit2: '#34d399', orbit3: '#fbbf24', orbit4: '#f472b6', orbit5: '#a78bfa',
                        sleep: '#1e293b', meal: '#94a3b8'
                    }
                }
            }
        }
    </script>
    <style>
        body { transition: background-color 0.3s ease, color 0.3s ease; }
        .calendar-grid {
            display: grid;
            grid-template-columns: 60px repeat(7, 1fr);
            gap: 1px;
            background-color: #e2e8f0;
            border: 1px solid #e2e8f0;
        }
        .dark .calendar-grid { background-color: #334155; border-color: #334155; }
        .time-label { grid-column: 1; }
        
        /* Drag and Drop classes */
        .draggable-block { cursor: grab; transition: transform 0.1s, filter 0.2s; position: relative; }
        .draggable-block:active { cursor: grabbing; transform: scale(0.95); }
        .draggable-block.dragging { opacity: 0.5; }
        .drop-zone { transition: background-color 0.2s; }
        .drop-zone.drag-over { background-color: #f1f5f9; }
        .dark .drop-zone.drag-over { background-color: #475569; }
        
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 dark:bg-gray-900 dark:text-gray-200 font-sans min-h-screen flex flex-col relative">

    <header class="w-full max-w-5xl mx-auto p-6 flex justify-between items-center">
        <div>
            <h1 class="font-serif text-2xl font-semibold">Everything You Neglect, You Lose</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400">Sistema Tú - Diseña tu semana con intención</p>
        </div>
        <button id="theme-toggle" class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-800 transition">
            <svg id="moon-icon" class="w-6 h-6 hidden dark:block text-yellow-300" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
            <svg id="sun-icon" class="w-6 h-6 block dark:hidden text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>
    </header>

    <main class="flex-grow w-full max-w-5xl mx-auto p-6">
        
        <!-- PANTALLA 1: SETUP -->
        <section id="setup-screen" class="max-w-3xl mx-auto mt-6 opacity-100 transition-opacity duration-500">
            <div class="text-center mb-8">
                <h2 class="font-serif text-3xl mb-4">Tu Sistema Tú</h2>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-sm">
                    Define hasta 5 roles. Selecciona cuántas horas necesitan y cuándo prefieres ejecutarlas. 
                    Calcularemos tu semana base, pero podrás mover o eliminar cualquier bloque después.
                </p>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-6 md:p-8 border border-gray-100 dark:border-gray-700">
                <form id="roles-form">
                    <div id="roles-container" class="space-y-6"></div>
                    
                    <button type="button" id="add-role-btn" class="mt-6 text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline flex items-center">
                        + Añadir otra órbita (Máximo 5)
                    </button>

                    <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
                        <button type="submit" class="w-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-semibold py-3 px-4 rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 transition shadow-lg">
                            Generar mi semana intencional
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <!-- PANTALLA 2: CALENDARIO -->
        <section id="calendar-screen" class="hidden opacity-0 transition-opacity duration-500">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-6 gap-4">
                <div>
                    <h2 class="font-serif text-2xl mb-2">Tu Semana Sugerida</h2>
                    <p class="text-sm text-gray-600 dark:text-gray-400">Todo es editable. Arrastra para mover, o haz clic en la "X" para eliminar un bloque.</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <button id="back-btn" class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition px-4 py-2 rounded border border-gray-200 dark:border-gray-700">
                        Volver
                    </button>
                    <button id="export-btn" class="text-sm font-medium bg-indigo-600 text-white hover:bg-indigo-700 transition px-4 py-2 rounded shadow flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        Exportar a Google Calendar
                    </button>
                </div>
            </div>

            <div id="legend-container" class="flex flex-wrap gap-4 mb-6 p-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700 text-sm"></div>

            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-100 dark:border-gray-700 overflow-hidden relative">
                <div class="grid grid-cols-8 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 text-center text-sm font-medium text-gray-500 dark:text-gray-400">
                    <div class="p-3 border-r border-gray-200 dark:border-gray-700">Hora</div>
                    <div class="p-3 border-r border-gray-200 dark:border-gray-700">Lun</div>
                    <div class="p-3 border-r border-gray-200 dark:border-gray-700">Mar</div>
                    <div class="p-3 border-r border-gray-200 dark:border-gray-700">Mié</div>
                    <div class="p-3 border-r border-gray-200 dark:border-gray-700">Jue</div>
                    <div class="p-3 border-r border-gray-200 dark:border-gray-700">Vie</div>
                    <div class="p-3 border-r border-gray-200 dark:border-gray-700 text-indigo-500">Sáb</div>
                    <div class="p-3 text-indigo-500">Dom</div>
                </div>
                <div class="h-[600px] overflow-y-auto calendar-grid" id="calendar-body"></div>
            </div>
            
            <p class="text-xs text-center text-gray-400 mt-6 font-serif italic mb-10">
                "Una semana mediocre que realmente sucedió es infinitamente más valiosa que un sistema perfecto que solo vive en tu mente."
            </p>
        </section>
    </main>

    <!-- Toast Notification (Mensaje Suave) -->
    <div id="toast" class="fixed bottom-5 right-5 transform translate-y-20 opacity-0 transition-all duration-300 bg-gray-800 dark:bg-gray-100 text-white dark:text-gray-900 px-6 py-3 rounded-lg shadow-lg flex items-center gap-3 z-50 pointer-events-none">
        <svg class="w-5 h-5 text-yellow-400 dark:text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span class="text-sm font-medium">Bloque retirado. Recuerda que dejar espacios en blanco también es parte del plan.</span>
    </div>

    <script>
        const roleColors = ['bg-orbit1', 'bg-orbit2', 'bg-orbit3', 'bg-orbit4', 'bg-orbit5'];
        const hexColors = ['#818cf8', '#34d399', '#fbbf24', '#f472b6', '#a78bfa'];
        let roleCount = 1;

        // UI Elements
        const rolesContainer = document.getElementById('roles-container');
        const addRoleBtn = document.getElementById('add-role-btn');
        const rolesForm = document.getElementById('roles-form');
        const setupScreen = document.getElementById('setup-screen');
        const calendarScreen = document.getElementById('calendar-screen');
        const themeToggleBtn = document.getElementById('theme-toggle');
        const toast = document.getElementById('toast');

        themeToggleBtn.addEventListener('click', () => document.documentElement.classList.toggle('dark'));

        function createRoleInput(id) {
            return `
                <div class="p-4 bg-gray-50 dark:bg-gray-700/30 rounded-lg border border-gray-200 dark:border-gray-700 role-row" id="role-row-${id}">
                    <div class="flex justify-between items-center mb-3">
                        <label class="block text-sm font-semibold text-gray-800 dark:text-gray-200">Órbita ${id}</label>
                        ${id > 1 ? `<button type="button" onclick="removeRole(${id})" class="text-xs text-red-500 hover:underline">Eliminar</button>` : ``}
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-start">
                        <div class="md:col-span-1">
                            <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Nombre</label>
                            <input type="text" required class="role-name w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 px-3 py-2 text-sm text-gray-900 dark:text-white" placeholder="Ej: Proyecto, Familia">
                        </div>
                        <div class="md:col-span-1">
                            <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Horas/Semana</label>
                            <input type="number" required min="1" max="100" class="role-hours w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 px-3 py-2 text-sm text-gray-900 dark:text-white" placeholder="Ej: 20">
                        </div>
                        <div class="md:col-span-1">
                            <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Días preferidos</label>
                            <select class="role-days w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 px-3 py-2 text-sm text-gray-900 dark:text-white">
                                <option value="any">Cualquier día</option>
                                <option value="weekdays">Lunes a Viernes</option>
                                <option value="weekends">Fines de semana</option>
                            </select>
                        </div>
                        <div class="md:col-span-1">
                            <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Horarios (Puedes marcar varios)</label>
                            <div class="space-y-1 text-sm text-gray-700 dark:text-gray-300 role-time-group" data-row-id="${id}">
                                <label class="flex items-center cursor-pointer"><input type="checkbox" value="morning" checked class="mr-2 rounded text-indigo-500 border-gray-300 bg-white dark:bg-gray-700"> Mañana (8h-13h)</label>
                                <label class="flex items-center cursor-pointer"><input type="checkbox" value="afternoon" class="mr-2 rounded text-indigo-500 border-gray-300 bg-white dark:bg-gray-700"> Tarde (14h-19h)</label>
                                <label class="flex items-center cursor-pointer"><input type="checkbox" value="night" class="mr-2 rounded text-indigo-500 border-gray-300 bg-white dark:bg-gray-700"> Noche (21h-22h)</label>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function removeRole(id) {
            document.getElementById(`role-row-${id}`).remove();
            roleCount--;
            addRoleBtn.classList.remove('hidden');
        }

        function showToast() {
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }

        rolesContainer.insertAdjacentHTML('beforeend', createRoleInput(1));

        addRoleBtn.addEventListener('click', () => {
            if (roleCount < 5) {
                roleCount++;
                rolesContainer.insertAdjacentHTML('beforeend', createRoleInput(roleCount));
                if (roleCount === 5) addRoleBtn.classList.add('hidden');
            }
        });

        rolesForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const names = document.querySelectorAll('.role-name');
            const hours = document.querySelectorAll('.role-hours');
            const days = document.querySelectorAll('.role-days');
            const timeGroups = document.querySelectorAll('.role-time-group');
            
            let totalHours = 0;
            let userRoles = [];

            for (let i = 0; i < names.length; i++) {
                const h = parseInt(hours[i].value);
                totalHours += h;
                
                const checkboxes = timeGroups[i].querySelectorAll('input[type="checkbox"]:checked');
                let selectedTimes = Array.from(checkboxes).map(cb => cb.value);
                if(selectedTimes.length === 0) selectedTimes = ['morning', 'afternoon', 'night'];

                userRoles.push({ 
                    name: names[i].value, 
                    hours: h, 
                    daysPref: days[i].value,
                    timePref: selectedTimes,
                    colorClass: roleColors[i], 
                    hex: hexColors[i],
                    id: `role-${i}`
                });
            }

            // Ya no hay límite estricto de validación, permitiendo sobreescribir bloques
            generateCalendar(userRoles);
            
            setupScreen.classList.add('opacity-0');
            setTimeout(() => {
                setupScreen.classList.add('hidden');
                calendarScreen.classList.remove('hidden');
                void calendarScreen.offsetWidth;
                calendarScreen.classList.remove('opacity-0');
            }, 300);
        });

        document.getElementById('back-btn').addEventListener('click', () => {
            calendarScreen.classList.add('opacity-0');
            setTimeout(() => {
                calendarScreen.classList.add('hidden');
                setupScreen.classList.remove('hidden');
                void setupScreen.offsetWidth;
                setupScreen.classList.remove('opacity-0');
            }, 300);
        });

        // Exportar a ICS (Apple / Google Calendar)
        document.getElementById('export-btn').addEventListener('click', () => {
            let ics = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//Sistema Tu//ES\nCALSCALE:GREGORIAN\n";
            
            // Buscar el próximo lunes para usarlo como fecha base de la "semana de prueba"
            let d = new Date();
            d.setDate(d.getDate() + ((1 + 7 - d.getDay()) % 7 || 7)); 
            d.setHours(0,0,0,0);

            const dropZones = document.querySelectorAll('.drop-zone');
            dropZones.forEach(zone => {
                if (zone.children.length > 0) {
                    const block = zone.children[0];
                    const title = block.querySelector('.block-label').innerText;
                    const dayOffset = parseInt(zone.dataset.d);
                    const hour = parseInt(zone.dataset.h);

                    let eventDate = new Date(d);
                    eventDate.setDate(d.getDate() + dayOffset);
                    eventDate.setHours(hour, 0, 0, 0);

                    let endDate = new Date(eventDate);
                    endDate.setHours(hour + 1, 0, 0, 0);

                    // Formato Local Floating Time para adaptarse al uso horario del usuario
                    const formatDate = (date) => {
                        const pad = (n) => n < 10 ? '0'+n : n;
                        return `${date.getFullYear()}${pad(date.getMonth()+1)}${pad(date.getDate())}T${pad(date.getHours())}${pad(date.getMinutes())}00`;
                    };

                    ics += "BEGIN:VEVENT\n";
                    ics += `SUMMARY:${title}\n`;
                    ics += `DTSTART:${formatDate(eventDate)}\n`;
                    ics += `DTEND:${formatDate(endDate)}\n`;
                    ics += `DESCRIPTION:Generado por Sistema Tú - Semana de Prueba\n`;
                    ics += "END:VEVENT\n";
                }
            });
            ics += "END:VCALENDAR";

            const blob = new Blob([ics], { type: 'text/calendar' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'sistema_tu_semana_prueba.ics';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        });

        // Generador de Calendario
        function generateCalendar(userRoles) {
            const body = document.getElementById('calendar-body');
            const legend = document.getElementById('legend-container');
            body.innerHTML = '';
            
            let legendHTML = `
                <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-slate-800 dark:bg-slate-300 mr-2 opacity-80"></span>Sueño</div>
                <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-slate-400 mr-2 opacity-80"></span>Comida</div>
            `;
            userRoles.forEach(r => {
                legendHTML += `<div class="flex items-center"><span class="w-3 h-3 rounded-full mr-2 opacity-80" style="background-color: ${r.hex}"></span>${r.name}</div>`;
            });
            legend.innerHTML = legendHTML;

            let grid = Array(24).fill().map(() => Array(7).fill(null));
            const morning = [8,9,10,11,12];
            const afternoon = [14,15,16,17,18,19];
            const night = [21,22];
            const allWorkingHours = [...morning, ...afternoon, ...night];

            // Inamovibles ahora son simplemente bloques creados automáticamente
            for (let d = 0; d < 7; d++) {
                grid[23][d] = { roleId: 'sleep', label: 'Sueño', color: 'bg-slate-800 dark:bg-slate-200 text-white dark:text-gray-900 opacity-90' };
                for (let h = 0; h < 7; h++) grid[h][d] = { roleId: 'sleep', label: 'Sueño', color: 'bg-slate-800 dark:bg-slate-200 text-white dark:text-gray-900 opacity-90' };
                grid[7][d] = { roleId: 'meal', label: 'Desayuno', color: 'bg-slate-400 dark:bg-slate-600 text-white opacity-80' };
                grid[13][d] = { roleId: 'meal', label: 'Comida', color: 'bg-slate-400 dark:bg-slate-600 text-white opacity-80' };
                grid[20][d] = { roleId: 'meal', label: 'Cena', color: 'bg-slate-400 dark:bg-slate-600 text-white opacity-80' };
            }

            // Algoritmo de distribución múltiple
            userRoles.forEach(role => {
                let hoursPlaced = 0;
                let validDays = role.daysPref === 'weekdays' ? [0,1,2,3,4] : (role.daysPref === 'weekends' ? [5,6] : [0,1,2,3,4,5,6]);
                
                let validHours = [];
                if(role.timePref.includes('morning')) validHours.push(...morning);
                if(role.timePref.includes('afternoon')) validHours.push(...afternoon);
                if(role.timePref.includes('night')) validHours.push(...night);

                // 1. Intentar encajar
                for (let d of validDays) {
                    for (let h of validHours) {
                        if (hoursPlaced < role.hours && grid[h][d] === null) {
                            grid[h][d] = { roleId: role.id, label: role.name, color: role.colorClass };
                            hoursPlaced++;
                        }
                    }
                }

                // 2. Fallback
                if (hoursPlaced < role.hours) {
                    for (let d = 0; d < 7; d++) {
                        for (let h of allWorkingHours) {
                            if (hoursPlaced < role.hours && grid[h][d] === null) {
                                grid[h][d] = { roleId: role.id, label: role.name, color: role.colorClass };
                                hoursPlaced++;
                            }
                        }
                    }
                }
            });

            // Renderizado
            for (let h = 0; h < 24; h++) {
                let hourLabel = document.createElement('div');
                hourLabel.className = 'time-label flex items-start justify-end pr-2 py-2 text-xs text-gray-400 font-medium bg-gray-50 dark:bg-gray-800 border-r border-b border-gray-200 dark:border-gray-700';
                hourLabel.innerHTML = `${h.toString().padStart(2, '0')}:00`;
                body.appendChild(hourLabel);

                for (let d = 0; d < 7; d++) {
                    let cell = document.createElement('div');
                    cell.className = 'drop-zone relative p-1 border-b border-r border-white dark:border-gray-800 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 transition flex items-center justify-center';
                    cell.dataset.h = h;
                    cell.dataset.d = d;

                    let content = grid[h][d];
                    
                    if (content) {
                        cell.innerHTML = `
                            <div draggable="true" class="group draggable-block w-full h-full flex items-center justify-center rounded-sm text-xs font-semibold text-white shadow-sm ${content.color}" data-role="${content.roleId}">
                                <span class="block-label truncate px-1 pointer-events-none">${content.label}</span>
                                <button class="delete-btn opacity-0 group-hover:opacity-100 absolute top-0 right-0 p-1 text-white bg-black bg-opacity-20 hover:bg-opacity-50 rounded-tr-sm rounded-bl-sm transition-opacity" title="Eliminar bloque">
                                    <svg class="w-3 h-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                </button>
                            </div>
                        `;
                    }
                    body.appendChild(cell);
                }
            }

            initDragAndDrop();
            initDeleteButtons();
        }

        // Eliminar Bloques
        function initDeleteButtons() {
            document.querySelectorAll('.delete-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const block = this.parentElement;
                    block.remove();
                    showToast();
                });
            });
        }

        // Drag and Drop Logic
        function initDragAndDrop() {
            const draggables = document.querySelectorAll('.draggable-block');
            const dropZones = document.querySelectorAll('.drop-zone');

            let draggedItem = null;
            let sourceZone = null;

            draggables.forEach(draggable => {
                draggable.addEventListener('dragstart', function(e) {
                    draggedItem = this;
                    sourceZone = this.parentElement;
                    setTimeout(() => this.classList.add('dragging'), 0);
                    e.dataTransfer.effectAllowed = 'move';
                });

                draggable.addEventListener('dragend', function() {
                    this.classList.remove('dragging');
                    dropZones.forEach(z => z.classList.remove('drag-over'));
                    draggedItem = null;
                });
            });

            dropZones.forEach(zone => {
                zone.addEventListener('dragover', e => {
                    e.preventDefault();
                    if(draggedItem) {
                        zone.classList.add('drag-over');
                    }
                });

                zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));

                zone.addEventListener('drop', function(e) {
                    e.preventDefault();
                    this.classList.remove('drag-over');
                    
                    if (!draggedItem) return;

                    // Si hay un bloque existente, intercambiarlos
                    if (this.children.length > 0) {
                        const existingBlock = this.children[0];
                        sourceZone.appendChild(existingBlock);
                    }
                    
                    this.appendChild(draggedItem);
                });
            });
        }
    </script>
</body>
</html>
